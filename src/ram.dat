// ram.dat — Comprehensive Tiny MIPS test program
// Tests: lb, add, sub, and, or, slt, addi, sb, beq(taken), j
//
// Register map: $s0=REGS[1], $s1=REGS[2], $s2=REGS[3], $s3=REGS[4]
//               $s4=REGS[5], $s5=REGS[6], $s6=REGS[7]
//
// Expected results after execution:
//   REGS[1]=$s0 = 15  (loaded 10, then addi +5)
//   REGS[2]=$s1 = 3   (loaded 3)
//   REGS[3]=$s2 = 13  (add: 10+3)
//   REGS[4]=$s3 = 7   (sub: 10-3)
//   REGS[5]=$s4 = 2   (and: 10&3)
//   REGS[6]=$s5 = 11  (or:  10|3)
//   REGS[7]=$s6 = 1   (slt: 3<10=1)
//   mem[62] = 13
//   mem[63] = 7
//   addi $s0,$s0,99 at addr 40 is SKIPPED by beq
// ============================================================

// Addr 0-3: lb $s0, 60($zero)   [0x8001003C]  $s0 = mem[60] = 10
10000000
00000001
00000000
00111100

// Addr 4-7: lb $s1, 61($zero)   [0x8002003D]  $s1 = mem[61] = 3
10000000
00000010
00000000
00111101

// Addr 8-11: add $s2,$s0,$s1    [0x00221820]  $s2 = 10+3 = 13
00000000
00100010
00011000
00100000

// Addr 12-15: sub $s3,$s0,$s1   [0x00222022]  $s3 = 10-3 = 7
00000000
00100010
00100000
00100010

// Addr 16-19: and $s4,$s0,$s1   [0x00222824]  $s4 = 10&3 = 2
00000000
00100010
00101000
00100100

// Addr 20-23: or $s5,$s0,$s1    [0x00223025]  $s5 = 10|3 = 11
00000000
00100010
00110000
00100101

// Addr 24-27: slt $s6,$s1,$s0   [0x0041382A]  $s6 = (3<10) = 1
00000000
01000001
00111000
00101010

// Addr 28-31: addi $s0,$s0,5    [0x20210005]  $s0 = 10+5 = 15
00100000
00100001
00000000
00000101

// Addr 32-35: sb $s2,62($zero)  [0xC003003E]  mem[62] = 13
11000000
00000011
00000000
00111110

// Addr 36-39: beq $s1,$s1,+1    [0x10420001]  branch TAKEN -> skip addr 40
// branch target = PC(40) + {imm[5:0]=000001,2b00} = 40+4 = 44
00010000
01000010
00000000
00000001

// Addr 40-43: addi $s0,$s0,99   [0x20210063]  *** SKIPPED by beq ***
00100000
00100001
00000000
01100011

// Addr 44-47: sb $s3,63($zero)  [0xC004003F]  mem[63] = 7
11000000
00000100
00000000
00111111

// Addr 48-51: j 0               [0x08000000]  jump back to 0 (halt loop)
00001000
00000000
00000000
00000000

